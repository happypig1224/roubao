# ==============================================================================
# Roubao (肉包) 生产环境变量配置模板 (.env)
# 复制此文件为 .env 并填入实际强口令：cp .env.example .env
# ==============================================================================

# 1. MySQL 数据库凭证
MYSQL_ROOT_PASSWORD=RoubaoProd2026SecureRoot!
MYSQL_DATABASE=roubao_blog
MYSQL_USER=roubao_user
MYSQL_PASSWORD=RoubaoProd2026UserSecurePass!

# 2. Redis 缓存密码
REDIS_PASSWORD=RoubaoProd2026RedisPass!

# 3. 管理员鉴权 Token (生产环境强制校验：长度不得小于16位，严禁使用默认值)
ADMIN_TOKEN=RoubaoProductionSecretToken2026Safe!

# 4. CORS 跨源白名单 (以英文逗号分隔，生产环境切勿配置为 *)
CORS_ALLOWED_ORIGINS=https://roubao.cloud,https://www.roubao.cloud,http://roubao.cloud,http://www.roubao.cloud,http://47.251.182.2,http://localhost

# 5. 前端公网访问基地址
NEXT_PUBLIC_SITE_URL=http://roubao.cloud

# 6. S3/MinIO 对象存储配置 (可选)
STORAGE_TYPE=s3
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_CDN_DOMAIN=
